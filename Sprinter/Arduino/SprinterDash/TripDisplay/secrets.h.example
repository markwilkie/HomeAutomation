#ifndef SECRETS_H
#define SECRETS_H

// ============================================================
// Copy this file to secrets.h and fill in your actual values.
// secrets.h is git-ignored and will not be committed.
// ============================================================

// WiFi credentials
#define VANSSID   "YOUR_VAN_SSID"
#define LFPSSID   "YOUR_HOME_SSID"
#define PASSWORD  "YOUR_WIFI_PASSWORD"

// Papertrail remote logging
#define PAPERTRAIL_HOST       "logsX.papertrailapp.com"
#define PAPERTRAIL_PORT       12345
#define PAPERTRAIL_SYSTEMNAME "tripdisplay"

// TripTracker ingestion API - reached over a Tailscale tunnel (the van's
// GL-iNet router is a tailnet node), not a public address. TRIPTRACKER_HOST
// is the home server's Tailscale IP (100.x.x.x) or MagicDNS name.
#define TRIPTRACKER_HOST        "100.x.x.x"
#define TRIPTRACKER_PORT        8000
#define TRIPTRACKER_DEVICE_KEY  "your-device-api-key"

#endif

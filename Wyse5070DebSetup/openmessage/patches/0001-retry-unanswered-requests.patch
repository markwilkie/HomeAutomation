+// newCatchUpGMClient wraps inner in the fail-fast client, logging its retries
+// through the app's logger.
+func (a *App) newCatchUpGMClient(inner GMClient) *failFastGMClient {
+	ff := newFailFastGMClient(inner)
+	ff.logger = a.Logger
+	return ff
+}

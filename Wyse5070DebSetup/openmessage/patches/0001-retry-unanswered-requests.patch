diff --git a/internal/app/gm_failfast_retry_test.go b/internal/app/gm_failfast_retry_test.go
new file mode 100644
index 0000000..8c116c7
--- /dev/null
+++ b/internal/app/gm_failfast_retry_test.go
@@ -0,0 +1,115 @@
+package app
+
+import (
+	"errors"
+	"reflect"
+	"testing"
+	"time"
+
+	"go.mau.fi/mautrix-gmessages/pkg/libgm"
+)
+
+func withRetryDelays(t *testing.T, delays ...time.Duration) *[]time.Duration {
+	t.Helper()
+	oldDelays, oldSleep := unansweredRetryDelays, retrySleep
+	var slept []time.Duration
+	unansweredRetryDelays = delays
+	retrySleep = func(d time.Duration) { slept = append(slept, d) }
+	t.Cleanup(func() { unansweredRetryDelays, retrySleep = oldDelays, oldSleep })
+	return &slept
+}
+
+func TestParseRetryDelays(t *testing.T) {
+	got := parseRetryDelays(" 30s, 2m,bogus,,-1s,5m ")
+	want := []time.Duration{30 * time.Second, 2 * time.Minute, 5 * time.Minute}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("parseRetryDelays = %v, want %v", got, want)
+	}
+	if got := parseRetryDelays(""); len(got) != 0 {
+		t.Fatalf("empty spec gave %v", got)
+	}
+}
+
+// A phone that misses the timeout and answers a retry does not stop the
+// catch-up.
+func TestRetryRecoversASleepyPhone(t *testing.T) {
+	slept := withRetryDelays(t, time.Second, 2*time.Second)
+	inner := &scriptedGMClient{errs: []error{unanswered(libgm.ErrPhoneNotResponding), nil}}
+	gm := newFailFastGMClient(inner)
+	if _, err := gm.FetchMessages("a", 10, nil); err != nil {
+		t.Fatalf("retry did not recover: %v", err)
+	}
+	if gm.Unanswered() != nil {
+		t.Fatal("a recovered request was recorded as unanswered")
+	}
+	if !reflect.DeepEqual(*slept, []time.Duration{time.Second}) {
+		t.Fatalf("slept %v, want one 1s delay", *slept)
+	}
+	for i, err := range callAll(gm) {
+		if err != nil {
+			t.Fatalf("call %d after recovery: %v", i, err)
+		}
+	}
+}
+
+// Every retry unanswered: the catch-up stops exactly as upstream's does.
+func TestRetryExhaustedStillFailsFast(t *testing.T) {
+	slept := withRetryDelays(t, time.Second, 2*time.Second)
+	miss := unanswered(libgm.ErrPhoneNotResponding)
+	inner := &scriptedGMClient{errs: []error{miss, miss, miss}}
+	gm := newFailFastGMClient(inner)
+	_, err := gm.FetchMessages("a", 10, nil)
+	if err != miss {
+		t.Fatalf("err = %v, want the last miss", err)
+	}
+	if inner.calls != 3 || len(*slept) != 2 {
+		t.Fatalf("calls = %d, sleeps = %v; want 3 calls and 2 sleeps", inner.calls, *slept)
+	}
+	for i, err := range callAll(gm) {
+		if !errors.Is(err, ErrGoogleCatchUpStopped) {
+			t.Fatalf("call %d after exhausted retries: %v", i, err)
+		}
+	}
+	if inner.calls != 3 {
+		t.Fatalf("%d calls reached libgm, want none after the miss", inner.calls)
+	}
+}
+
+// A closed connection and other errors are never retried.
+func TestRetryOnlyForAPhoneThatDidNotRespond(t *testing.T) {
+	slept := withRetryDelays(t, time.Second)
+	for _, e := range []error{unanswered(libgm.ErrConnectionClosed), errors.New("HTTP 401")} {
+		inner := &scriptedGMClient{errs: []error{e}}
+		gm := newFailFastGMClient(inner)
+		if _, err := gm.FetchMessages("a", 10, nil); err != e {
+			t.Fatalf("err = %v, want %v unchanged", err, e)
+		}
+		if inner.calls != 1 {
+			t.Fatalf("%v was retried", e)
+		}
+	}
+	if len(*slept) != 0 {
+		t.Fatalf("slept %v", *slept)
+	}
+}
+
+// A request that waited out its retries while another one gave up does not
+// try again: the catch-up has already stopped.
+func TestRetryStopsWhenAnotherRequestGaveUp(t *testing.T) {
+	withRetryDelays(t, time.Second)
+	inner := &scriptedGMClient{errs: []error{unanswered(libgm.ErrPhoneNotResponding)}}
+	gm := newFailFastGMClient(inner)
+	other := unanswered(libgm.ErrConnectionClosed)
+	retrySleep = func(time.Duration) {
+		gm.mu.Lock()
+		gm.unanswered = other
+		gm.mu.Unlock()
+	}
+	_, err := gm.FetchMessages("a", 10, nil)
+	if !errors.Is(err, ErrGoogleCatchUpStopped) || !errors.Is(err, libgm.ErrConnectionClosed) {
+		t.Fatalf("err = %v, want ErrGoogleCatchUpStopped wrapping the other miss", err)
+	}
+	if inner.calls != 1 {
+		t.Fatalf("%d calls, want no retry after the catch-up stopped", inner.calls)
+	}
+}

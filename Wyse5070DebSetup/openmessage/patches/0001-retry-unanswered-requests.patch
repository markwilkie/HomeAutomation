+func parseRetryDelays(spec string) []time.Duration {
+	var delays []time.Duration
+	for _, part := range strings.Split(spec, ",") {
+		part = strings.TrimSpace(part)
+		if part == "" {
+			continue
+		}
+		d, err := time.ParseDuration(part)
+		if err != nil || d < 0 {
+			continue
+		}
+		delays = append(delays, d)
+	}
+	return delays
 }
 

+// comma-separated list of durations ("30s,2m,5m"). Unset or empty keeps
+// upstream's behaviour: no retries.
+var unansweredRetryDelays = parseRetryDelays(os.Getenv("OPENMESSAGES_UNANSWERED_RETRY_DELAYS"))
+
+// retrySleep is swapped out by tests.
+var retrySleep = time.Sleep

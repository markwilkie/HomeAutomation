+//
+// Local patch: before a request counts as unanswered, a phone that did not
+// respond is asked again after each delay in unansweredRetryDelays. A dozing
+// Android phone often misses libgm's fixed timeout once and then answers the
+// retry, so a long backfill no longer dies on the first sleepy moment. A
+// closed connection is not retried (the catch-up's client is gone).
 type failFastGMClient struct {
-	inner GMClient
+	inner  GMClient
+	logger zerolog.Logger
 
 	mu         sync.Mutex
 	unanswered error
 }
 
 func newFailFastGMClient(inner GMClient) *failFastGMClient {
-	return &failFastGMClient{inner: inner}
+	return &failFastGMClient{inner: inner, logger: zerolog.Nop()}

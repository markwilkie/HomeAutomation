@@ -32,7 +32,7 @@ func googleSupervisorPolicy() bridge.Policy {
 		ConnectTimeout:     2*time.Minute + 30*time.Second,
 		ProbeEvery:         time.Minute,
 		ProbeTimeout:       75 * time.Second,
-		LivenessTimeout:    12 * time.Minute,
+		LivenessTimeout:    googleLivenessTimeout(),
 		MinBackoff:         5 * time.Second,
 		MaxBackoff:         5 * time.Minute,
 		MaxSameFingerprint: 5,
@@ -42,6 +42,18 @@ func googleSupervisorPolicy() bridge.Policy {
 	}
 }
 
+// googleLivenessTimeout is how long the link may stay silent before the
+// supervisor probes it with a ditto ping. Local patch: like libgm's own
+// pings, each probe tells the phone a web user is active and silences its
+// notifications, so OPENMESSAGES_GOOGLE_LIVENESS_TIMEOUT can stretch it;
+// unset keeps upstream's 12 minutes.
+func googleLivenessTimeout() time.Duration {
+	if timeout, err := time.ParseDuration(os.Getenv("OPENMESSAGES_GOOGLE_LIVENESS_TIMEOUT")); err == nil && timeout > 0 {
+		return timeout
+	}
+	return 12 * time.Minute
+}
+
 type googleWallClock struct{}
 
 func (googleWallClock) Now() time.Time { return time.Now() }

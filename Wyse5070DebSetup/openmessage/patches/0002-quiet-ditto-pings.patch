+	// Local patch: each ditto ping tells the phone a web user is active, and
+	// while one is, Google Messages delivers notifications silently (and so
+	// does a paired watch). libgm pings every minute, so the phone never
+	// buzzed. OPENMESSAGES_GOOGLE_PING_INTERVAL (libgm accepts 1m to <4h)
+	// pings less often; unset keeps libgm's default.
+	if interval, err := time.ParseDuration(os.Getenv("OPENMESSAGES_GOOGLE_PING_INTERVAL")); err == nil {
+		cli.SetPingInterval(interval)
+	}
 	return cli
 }
 

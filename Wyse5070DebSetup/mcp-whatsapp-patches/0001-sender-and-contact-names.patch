 // contactNameExpr coalesces the whatsmeow_contacts name columns in preference
 // order: the saved address-book name first, then push name, first name, and
@@ -24,6 +29,46 @@ func (s *Store) ContactName(jid string) string {
 	return name.String
 }
 
+// RefreshChatNames replaces placeholder 1:1 chat names -- empty, or the
+// bare number a chat is named after when it arrives before its contact has
+// synced -- with the contact's name once one is known. Returns how many
+// chats were renamed.
+func (s *Store) RefreshChatNames(ctx context.Context) (int, error) {
+	rows, err := s.db.QueryContext(ctx, `SELECT jid, COALESCE(name,'') FROM chats WHERE jid NOT LIKE '%@g.us'`)
+	if err != nil {
+		return 0, fmt.Errorf("refresh chat names: %w", err)
+	}
+	type rename struct{ jid, name string }
+	var renames []rename
+	for rows.Next() {
+		var jid, name string
+		if err := rows.Scan(&jid, &name); err != nil {
+			rows.Close()
+			return 0, err
+		}
+		if name != "" && strings.Trim(name, "0123456789+") != "" {
+			continue
+		}
+		user := jidUser(jid)
+		for _, candidate := range []string{jid, user + "@s.whatsapp.net", user + "@lid"} {
+			if n := s.ContactName(candidate); n != "" && n != name {
+				renames = append(renames, rename{jid, n})
+				break
+			}
+		}
+	}
+	rows.Close()
+	if err := rows.Err(); err != nil {
+		return 0, err
+	}
+	for _, r := range renames {
+		if _, err := s.db.ExecContext(ctx, `UPDATE chats SET name = ? WHERE jid = ?`, r.name, r.jid); err != nil {
+			return 0, fmt.Errorf("refresh chat names: %w", err)
+		}
+	}
+	return len(renames), nil
+}
+
 // searchContactNames returns address-book contacts whose name or JID matches
 // the LIKE pattern, as a jid -> display-name map. Empty when the whatsmeow
 // store is unavailable.
